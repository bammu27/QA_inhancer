# Python project .gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
Dist/
*.egg-info/
.eggs/
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.coverage
.coverage.*
.nox/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# PyInstaller
*.manifest
*.spec

# Virtual environment
.env
.venv/
venv/
ENV/
env/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# VS Code settings
.vscode/

# PyCharm
.idea/
*.iml

# macOS
.DS_Store

# Windows thumbnail cache files
Thumbs.db

# Logs
*.log

# SQLite database files
*.sqlite3

# Data files
*.csv
*.tsv

# Build output
dist/